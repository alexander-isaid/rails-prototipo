<tr data-turbo="false">
    <td><%= cliente.email %></td>
    <td><%= cliente.password %></td>
    <td><%= cliente.password_confirmation %></td>
    <td><%= cliente.name %></td>
    <td><%= cliente.rol %></td>
    <td class="text-center">
      <div class="btn-group" role="group">
        <%= link_to "<i class='bi bi-eye-fill'></i>".html_safe, cliente, class: 'btn btn-primary rounded-circle' %>
        <%= link_to "<i class='bi bi-pencil-fill'></i>".html_safe, edit_cliente_path(cliente), class: 'btn btn-primary rounded-circle' %>
        <%= link_to "<i class='bi bi-archive-fill'></i>".html_safe, cliente, method: :delete, data: { confirm: 'Esta seguro de eliminar este registro!!' }, class: 'btn btn-primary rounded-circle' %>
      </div>
    </td>
</tr>