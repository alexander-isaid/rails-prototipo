<div id="div-busqueda" class="card-body border-bottom">
    <%= search_form_for @q , html: {"data-controller": "filters", "data-turbo-frame": "table"} do |f| %>
      <table class="table" style=" table-layout: fixed;">
        <thead>
          <tr>
            <th>
                <label>Titulo</label>
                <%= f.search_field :titulo_cont, class: 'form-control', "data-action": "filters#submit", placeholder:""  %>
            </th>
            <th>
                <label>Descripcion</label>
                <%= f.search_field :descripcion_cont, class: 'form-control', "data-action": "filters#submit", placeholder:""  %>
            </th>
            <th>
                <label>Fecha Creacion</label>
                <%= f.date_field :fecha_creacion_gteq, class: 'form-control', "data-action": "filters#submit", placeholder: "desde"  %>
                <%= f.date_field :fecha_creacion_lteq, class: 'form-control', "data-action": "filters#submit", placeholder: "hasta"  %>
            </th>
            <th>
                <label>User</label>
                <%= f.select :user_id_eq, User.all.map{|a| [a.name, a.id]}, { include_blank: "Todos" }, class: 'form-control',  "data-action": "filters#submit" %>
            </th>
        
            <th>
                <%= f.submit "Buscar!", class: 'btn btn-primary' %> 
                <a href="/posts" id="clear_search" class="btn btn-secondary">Todos!!</a>
            </th>
          </tr>
        </thead>
      </table>
    <% end %>
  </div>
