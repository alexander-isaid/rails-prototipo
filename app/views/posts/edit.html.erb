<div class="container">

  <div class="card">
    <div class="card-header">
      <h1> Editar Post</h1>
    </div>
    <div class="card-body">
      <%= render "form", post: @post %>
    </div>
    <div class="card-footer" style="margin-top: 25px;">
      <%= link_to '<i class="bi bi-arrow-left"></i>'.html_safe, posts_path, class: "btn btn-primary rounded-circle" %>
      <%= link_to "<i class='bi bi-eye-fill'></i>".html_safe, @post, class: 'btn btn-primary rounded-circle float-right' %>
    </div>
  </div>
</div>
