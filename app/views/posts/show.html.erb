<div class="container">

  <div class="card">
    <div class="card-body">
      <div class="row border-bottom">
          <div class="col-md-2 p-3 "><b>Titulo:</b></div>
          <div class="col-md-4 p-3 "><%= @post.titulo %></div>
      </div>
      <div class="row border-bottom">
          <div class="col-md-2 p-3 "><b>Descripcion:</b></div>
          <div class="col-md-4 p-3 "><%= @post.descripcion %></div>
      </div>
      <div class="row border-bottom">
          <div class="col-md-2 p-3 "><b>Fecha Creacion:</b></div>
          <div class="col-md-4 p-3 "><%= @post.fecha_creacion %></div>
      </div>
      <div class="row border-bottom">
          <div class="col-md-2 p-3 "><b>User:</b></div>
          <div class="col-md-4 p-3 "><%= @post.user.name %></div>
      </div>


      <%= link_to '<i class="bi bi-pencil-fill"></i> Editar'.html_safe,  edit_post_path(@post), class: 'btn btn-warning' %>
    </div>

    <div class="card-footer" style="margin-top: 25px;">
      <%= link_to '<i class="bi bi-arrow-left"></i>'.html_safe, posts_path, class: "btn btn-primary rounded-circle" %>
      <%= link_to '<i class="bi bi-trash3"></i>'.html_safe, @post, data: {turbo_method: :delete, turbo_confirm: "Esta seguro de eleiminar este registro"} , class: 'btn btn-danger rounded-circle float-right' %>
    </div>
  </div>
</div>