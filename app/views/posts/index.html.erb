<div class="card">
  <div class="card-header">
    <h5 class="card-title">
      <h1>Posts</h1>
      <%= link_to "Nuevo Post", new_post_path, class: 'btn btn-primary rounded-pill' %>
    </h5>
  </div>
  <div class="card-body">
    <%= render "filtros" %>
    <div id="posts">
      <table id="tabla_posts" class="table table-striped">
        <thead>
          <tr>

              <th class="text-left"><%= sort_link @q, :titulo, "Titulo" %></th>

              <th class="text-left"><%= sort_link @q, :descripcion, "Descripcion" %></th>

              <th class="text-left"><%= sort_link @q, :fecha_creacion, "Fecha Creacion" %></th>

              <th class="text-left"><%= sort_link @q, :user_id, "User" %></th>
            <td class="text-center">Ver</td>
          </tr>
        </thead>
        <tbody>
          <% @posts.each do | post| %>
            <%= render "rows",  post: post %>
          <% end %>
        </tbody>
      </table>
      <%= paginate @posts, param_name: :pagina, pagination_class: "pagination-small pagination-centered" %>
      
    </div>
  </div>
</div>


