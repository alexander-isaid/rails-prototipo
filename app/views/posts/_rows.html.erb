<tr data-turbo="false">
    <td><%= post.titulo %></td>
    <td><%= post.descripcion %></td>
    <td><%= post.fecha_creacion %></td>
    <td><%= post.user.name %></td>
    <td class="text-center">
      <div class="btn-group" role="group">
        <%= link_to "<i class='bi bi-eye-fill'></i>".html_safe, post, class: 'btn btn-primary rounded-circle' %>
        <%= link_to "<i class='bi bi-pencil-fill'></i>".html_safe, edit_post_path(post), class: 'btn btn-primary rounded-circle' %>
        <%= link_to "<i class='bi bi-archive-fill'></i>".html_safe, post, method: :delete, data: { confirm: 'Esta seguro de eliminar este registro!!' }, class: 'btn btn-primary rounded-circle' %>
      </div>
    </td>
</tr>