<tr data-turbo="false">
    <td><%= usuario.email %></td>
    <td><%= usuario.name %></td>
    <td><%= usuario.rol %></td>
    <td class="text-center">
      <div class="btn-group" role="group">
        <%= link_to "<i class='bi bi-eye-fill'></i>".html_safe, usuario, class: 'btn btn-primary rounded-circle' %>
        <%= link_to "<i class='bi bi-pencil-fill'></i>".html_safe, edit_usuario_path(usuario), class: 'btn btn-primary rounded-circle' %>
        <%= link_to "<i class='bi bi-archive-fill'></i>".html_safe, usuario, method: :delete, data: { confirm: 'Esta seguro de eliminar este registro!!' }, class: 'btn btn-primary rounded-circle' %>
      </div>
    </td>
</tr>