<div class="container">

  <div class="card">
    <div class="card-header">
      <h1> Editar Usuario</h1>
    </div>
    <div class="card-body">
      <%= render "form", usuario: @usuario %>
    </div>
    <div class="card-footer" style="margin-top: 25px;">
      <%= link_to '<i class="bi bi-arrow-left"></i>'.html_safe, usuarios_path, class: "btn btn-primary rounded-circle" %>
      <%= link_to "<i class='bi bi-eye-fill'></i>".html_safe, @usuario, class: 'btn btn-primary rounded-circle float-right' %>
    </div>
  </div>
</div>
