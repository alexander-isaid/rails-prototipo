<div class="container">

  <div class="card">
    <div class="card-body">
      <div class="row border-bottom">
          <div class="col-md-2 p-3 "><b>Email:</b></div>
          <div class="col-md-4 p-3 "><%= @usuario.email %></div>
      </div>
      <div class="row border-bottom">
          <div class="col-md-2 p-3 "><b>Password:</b></div>
          <div class="col-md-4 p-3 "><%= @usuario.password %></div>
      </div>
      <div class="row border-bottom">
          <div class="col-md-2 p-3 "><b>Password_confirmation:</b></div>
          <div class="col-md-4 p-3 "><%= @usuario.password_confirmation %></div>
      </div>
      <div class="row border-bottom">
          <div class="col-md-2 p-3 "><b>Name:</b></div>
          <div class="col-md-4 p-3 "><%= @usuario.name %></div>
      </div>
      <div class="row border-bottom">
          <div class="col-md-2 p-3 "><b>Rol:</b></div>
          <div class="col-md-4 p-3 "><%= @usuario.rol %></div>
      </div>


      <%= link_to '<i class="bi bi-pencil-fill"></i> Editar'.html_safe,  edit_usuario_path(@usuario), class: 'btn btn-warning' %>
    </div>

    <div class="card-footer" style="margin-top: 25px;">
      <%= link_to '<i class="bi bi-arrow-left"></i>'.html_safe, usuarios_path, class: "btn btn-primary rounded-circle" %>
      <%= link_to '<i class="bi bi-trash3"></i>'.html_safe, @usuario, data: {turbo_method: :delete, turbo_confirm: "Esta seguro de eleiminar este registro"} , class: 'btn btn-danger rounded-circle float-right' %>
    </div>
  </div>
</div>