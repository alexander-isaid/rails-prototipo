<div id="<%= dom_id audit_log %>">
  <p>
    <strong>Auditable:</strong>
    <%= audit_log.auditable_id %>
  </p>

  <p>
    <strong>Auditable type:</strong>
    <%= audit_log.auditable_type %>
  </p>

  <p>
    <strong>Associated:</strong>
    <%= audit_log.associated_id %>
  </p>

  <p>
    <strong>Associated type:</strong>
    <%= audit_log.associated_type %>
  </p>

  <p>
    <strong>User:</strong>
    <%= audit_log.user_id %>
  </p>

  <p>
    <strong>User type:</strong>
    <%= audit_log.user_type %>
  </p>

  <p>
    <strong>Username:</strong>
    <%= audit_log.username %>
  </p>

  <p>
    <strong>Action:</strong>
    <%= audit_log.action %>
  </p>

  <p>
    <strong>Audited changes:</strong>
    <%= audit_log.audited_changes %>
  </p>

  <p>
    <strong>Version:</strong>
    <%= audit_log.version %>
  </p>

  <p>
    <strong>Comment:</strong>
    <%= audit_log.comment %>
  </p>

  <p>
    <strong>Remote address:</strong>
    <%= audit_log.remote_address %>
  </p>

  <p>
    <strong>Request uuid:</strong>
    <%= audit_log.request_uuid %>
  </p>

  <p>
    <strong>Created at:</strong>
    <%= audit_log.created_at %>
  </p>

</div>
