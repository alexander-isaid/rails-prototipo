<div class="container">

  <div class="card">
    <div class="card-header">
      <h1> Registrar <%= singular_table_name.split("_").map{|x| x.capitalize}.join(" ") %></h1>
    </div>
    <div class="card-body">
      <%%= render "form", <%= singular_table_name%>: @<%= singular_table_name %> %>
    </div>
    <div class="card-footer" style="margin-top: 25px;">
      <%%= link_to '<i class="bi bi-arrow-left"></i>'.html_safe, <%= plural_table_name %>_path, class: "btn btn-primary rounded-circle" %>
    </div>
  </div>
</div>